%% =============================================================================
%% Standalone rebar3 project. This is the Jepsen-facing OTP wrapper
%% (HTTP shim + 3-node disterl cluster wiring) consumed by the Clojure
%% Jepsen test under `../jepsen.bondymst/`.
%%
%% It exercises the full stack through `bondy_db` (the consumer facade). It is
%% a sibling project of the bondy umbrella — `rebar3 compile` of the umbrella
%% never pulls cowboy, jsx, or this app into the apps' builds. The release is
%% built by running rebar3 inside this directory (see the umbrella `justfile`:
%% `rel-jepsen`).
%% =============================================================================

{minimum_otp_vsn, "R26"}.

{erl_opts, [
    debug_info
]}.

{deps, [
    %% The umbrella apps come from `_checkouts/`, tracked symlinks to
    %% `../../../apps/`; the git sources are never fetched while they exist.
    %% rebar3 uses a checkout only for a declared dep, and the umbrella apps
    %% do not declare each other, so every app `bondy_db` needs is listed.
    %% `utils` and `partisan` are declared by the umbrella root, not by the
    %% apps that need them.
    {bondy_db, {git_subdir, "https://github.com/bondy-io/bondy-connect.git",
                {tag, "1.0.2"}, "apps/bondy_db"}},
    {bondy_oplog, {git_subdir, "https://github.com/bondy-io/bondy-connect.git",
                {tag, "1.0.2"}, "apps/bondy_oplog"}},
    {bondy_mst, {git_subdir, "https://github.com/bondy-io/bondy-connect.git",
                {tag, "1.0.2"}, "apps/bondy_mst"}},
    {bondy_log, {git_subdir, "https://github.com/bondy-io/bondy-connect.git",
                {tag, "1.0.2"}, "apps/bondy_log"}},
    {bondy_connect_lib, {git_subdir, "https://github.com/bondy-io/bondy-connect.git",
                {tag, "1.0.2"}, "apps/bondy_connect_lib"}},
    {bondy_metrics, {git_subdir, "https://github.com/bondy-io/bondy-connect.git",
                {tag, "1.0.2"}, "apps/bondy_metrics"}},
    {bondy_cluster, {git_subdir, "https://github.com/bondy-io/bondy-connect.git",
                {tag, "1.0.2"}, "apps/bondy_cluster"}},
    {utils, {git, "https://github.com/leapsight/utils.git", {tag, "1.4.3"}}},
    {partisan, {git, "https://github.com/lasp-lang/partisan.git",
                {tag, "v6.3.2"}}},
    {cowboy, "2.13.0"},
    {jsx, "3.1.0"}
]}.

{relx, [
    {release, {bondy_mst_jepsen_release, "0.4.0"}, [
        compiler,
        crypto,
        inets,
        kernel,
        os_mon,
        runtime_tools,
        sasl,
        stdlib,
        tools,
        app_config,
        utils,
        resulto,
        memory,
        bloomfi,
        leveled,
        telemetry,
        cowlib,
        ranch,
        cowboy,
        jsx,
        %% `bondy_cluster` initialises Partisan's configuration at start;
        %% nothing starts Partisan itself.
        {partisan, load},
        bondy_mst,
        bondy_oplog,
        bondy_db,
        bondy_mst_jepsen
    ]},
    {dev_mode, false},
    {include_src, false},
    {include_erts, true},
    {extended_start_script, true},
    {sys_config, "config/sys.config"},
    {vm_args, "config/vm.args"}
]}.

{profiles, [
    {test, [
        {erl_opts, [nowarn_export_all]}
    ]}
]}.
