{minimum_otp_vsn, "29"}.
{erl_opts, [debug_info]}.

%% Inter-app dependencies. Inside the Bondy umbrella these resolve to the local
%% project apps (which shadow same-named deps); declared here as `git_subdir' so
%% that external consumers pulling `bondy_connect_sdk' via `git_subdir' get the whole
%% chain fetched transitively (they only declare `bondy_connect_sdk'). There is
%% deliberately NO dependency on the `bondy' router app.
%%
%% The refs name the release tag, so an external consumer gets every sibling
%% from the same release. Move them to the new tag when cutting a release.
{deps, [
    {bondy_connect_lib,
        {git_subdir, "https://github.com/bondy-io/bondy-connect.git",
            {tag, "1.0.2"},
            "apps/bondy_connect_lib"}},
    {bondy_wamp,
        {git_subdir, "https://github.com/bondy-io/bondy-connect.git",
            {tag, "1.0.2"},
            "apps/bondy_wamp"}},
    {bondy_regulator,
        {git_subdir, "https://github.com/bondy-io/bondy-connect.git",
            {tag, "1.0.2"},
            "apps/bondy_regulator"}},
    {gun, "2.4.1"},
    %% Declared as a runtime dependency in bondy_connect_sdk.app.src's `applications'
    %% list, but never as a fetchable one anywhere in this chain — an external
    %% consumer's build never fetches it, so `application:ensure_all_started
    %% (bondy_connect_sdk)' fails at runtime with "could not find application file:
    %% telemetry.app". A real, published hex.pm package; safe to add directly.
    {telemetry, "~> 1.3"}
]}.

%% =============================================================================
%% REBAR
%% =============================================================================


{project_plugins, [
    rebar3_ex_doc,
    rebar3_proper
]}.

{shell, [
    {apps, [bondy_connect_sdk]}
]}.

{xref_checks, [undefined_function_calls]}.

%% =============================================================================
%% DOCS
%% =============================================================================


{ex_doc, [
    {source_url, <<"https://github.com/bondy-io/bondy-connect">>},
    {extras, [
        <<"README.md">>,
        {<<"apps/bondy_connect_sdk/doc_extras/tutorial.md">>, #{title => <<"Tutorial">>}}
    ]},
    {main, <<"README.md">>}
]}.
